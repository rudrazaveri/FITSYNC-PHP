# =====================================================================
# FitSync AI — Environment Configuration Template (.env.example)
# Copy to .env and configure for your local environment
# =====================================================================

APP_ENV=development
APP_URL=http://localhost/FIT-SYNC%20AI%20php
APP_DEBUG=true

# Database Configuration (MySQL / MariaDB via XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fitsync_db
DB_USER=root
DB_PASS=

# Session Security Configuration
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
SESSION_COOKIE_SAMESITE=Lax

# Mail / SMTP Configuration (Optional in development)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@fitsync.health
