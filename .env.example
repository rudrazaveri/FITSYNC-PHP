# FitSync AI — Production Environment Variables
# Provide your Supabase project credentials below

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Public API URL & Anon Key (Client safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (SERVER ONLY - Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here
